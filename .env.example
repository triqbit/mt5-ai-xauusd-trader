# MT5 AI/ML Trading Bot - Environment Configuration Template

# MT5 Connection
MT5_LOGIN=0
MT5_PASSWORD=your_password_here
MT5_SERVER=your_server_here
MT5_PATH=C:/Program Files/MetaTrader 5/terminal64.exe

# MetaAPI (cloud fallback)
METAAPI_TOKEN=
METAAPI_ACCOUNT_ID=

# Trading parameters
SYMBOL=XAUUSD
TIMEFRAME=M5
MODE=demo
MAX_POSITIONS=3
RISK_PER_TRADE=0.01
MAX_DAILY_LOSS=0.05

# Model
ALGORITHM=ensemble
MODEL_PATH=models/trained/ensemble_latest.pt
TRAIN_STEPS=1000000
DEVICE=auto
CONFIDENCE_THRESHOLD=0.6

# Database
DATABASE_URL=postgresql://trader:password@localhost:5432/mt5_trades
REDIS_URL=redis://localhost:6379/0

# Monitoring
PROMETHEUS_PORT=8000
DASHBOARD_PORT=8050
LOG_LEVEL=INFO
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Safety Gate
CONFIRM_LIVE_TRADING=NO
